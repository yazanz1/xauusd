SUPABASE_URL=https://pcieshmxxwplaodkrqet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

MT5_SYMBOL=XAUUSD
LOT_SIZE=0.01
PIP_SIZE=0.1

# Documentation only — bot is fixed on wick (+60). active_filters() always [].
# STRATEGY in .env does not load breakout filters.
STRATEGY=wick

# Execution
POLL_SEC=5
MAX_AGE_SEC=180
# Slip allowed = min(MAX_SLIP_USD, MAX_SLIP_STOP_FRAC × |entry − stop|)
MAX_SLIP_USD=1.50
MAX_SLIP_STOP_FRAC=0.20
MAX_OPEN=6
DRY_RUN=0
LOCK_ENABLE=1
LOCK_SL_FRAC=0.30

# Filter modules under bot1_filters/ are kept but not loaded (active_filters always []).
H1_EMA_MODE=off
FILTER_NY_MIDDAY_MODE=shadow
NY_MIDDAY_START=12:00
NY_MIDDAY_END=14:00
FILTER_ONE_PER_BAR_MODE=shadow
FILTER_MIN_RR_MODE=off
MIN_RR=1.0

# MT5 account
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=VantageMarkets-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT_MS=60000

# Optional: full path to venv python for watchdog.ps1 (else uses .venv\Scripts\python.exe)
# WATCHDOG_PYTHON=C:\bots\xauusd\.venv\Scripts\python.exe

# Gann grids (daily / London 08:00 / NY 08:30) are written to gann_levels.
